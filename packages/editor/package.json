{
  "name": "@mind-hub/editor",
  "version": "0.2.0",
  "description": "Mind Editor - Extensible, open-source Notion-like block editor for Vue 3 and Tiptap v2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mind-hub/shared": "workspace:*",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.3"
  }
}
